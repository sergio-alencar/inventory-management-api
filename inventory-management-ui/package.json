{
  "name": "inventory-management-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tailwind-init": "tailwindcss init -p",
    "tw:init": "tailwindcss init",
    "tw:cli": "node ./node_modules/tailwindcss/lib/cli.js init",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:production": "cross-env VITE_API_URL=https://inventory-management-api-48yw.onrender.com/api start-server-and-test dev http://localhost:5173 test:e2e",
    "test:e2e:local": "cross-env VITE_API_URL=http://localhost:5155/api start-server-and-test dev http://localhost:5173 test:e2e",
    "test:e2e:render": "cross-env VITE_API_URL=https://inventory-management-api-48yw.onrender.com/api start-server-and-test dev http://localhost:5173 \"playwright test\""
  },
  "dependencies": {
    "axios": "^1.13.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "start-server-and-test": "^3.0.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
